# Copy to .env.local for local testing. On Vercel, add these under
# Project → Settings → Environment Variables. Never commit real values.

# Primary: Zoho Mail (sends sign-ups to developer@outstyl.in)
ZOHO_SMTP_USER=developer@outstyl.in
ZOHO_SMTP_PASS=
# smtp.zoho.in for India-hosted Zoho accounts, smtp.zoho.com otherwise
ZOHO_SMTP_HOST=smtp.zoho.in

# Fallback: Gmail (used only if Zoho fails; sends to outstyyl@gmail.com)
GMAIL_USER=outstyyl@gmail.com
GMAIL_APP_PASSWORD=

# Optional overrides
# WAITLIST_TO=developer@outstyl.in
# WAITLIST_FALLBACK_TO=outstyyl@gmail.com
